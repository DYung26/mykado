---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { services } from '../../data/services';

export async function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;

const otherServices = services.filter((s) => s.slug !== service.slug);
---

<Layout
  title={`${service.title} in Lagos | Mykado Engineering`}
  description={service.shortDescription}
>
  <Navbar />

  <section class="service-hero">
    <div class="hero-bg">
      <img src={service.image} alt={service.title} class="hero-img" fetchpriority="high" />
      <div class="hero-overlay"></div>
    </div>
    <div class="hero-content">
      <a href="/#services" class="breadcrumb">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" width="14" height="14">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
        </svg>
        All Services
      </a>
      <p class="service-tag">Our Services</p>
      <h1>{service.title}</h1>
      <p class="service-lead">{service.shortDescription}</p>
      <a href="/#contact" class="btn-primary">Request a Consultation</a>
    </div>
  </section>

  <div class="service-body-wrap">
    <div class="service-content">

      <div class="service-main">
        <div class="prose">
          {service.longDescription.split('\n\n').map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>

        <div class="deliverables">
          <h2>What We Deliver</h2>
          <ul>
            {service.deliverables.map((item) => (
              <li>
                <span class="bullet">✦</span>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <aside class="service-sidebar">
        <div class="cta-card">
          <p class="cta-tag">Ready to start?</p>
          <h3>Talk to Our Engineers</h3>
          <p>Tell us about your project and we'll get back to you within one business day.</p>
          <a href="/#contact" class="btn-primary">Get In Touch</a>
          <a href="tel:+2347030480708" class="contact-direct">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" width="16" height="16">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
            </svg>
            +234 703 048 0708
          </a>
        </div>

        <div class="other-services">
          <p class="sidebar-heading">Other Services</p>
          {otherServices.map((s) => (
            <a href={`/services/${s.slug}`} class="other-service-link">
              <span class="other-service-icon" set:html={s.icon} />
              <span>{s.title}</span>
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" width="12" height="12" class="arrow">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </a>
          ))}
        </div>
      </aside>
    </div>
  </div>

  <Footer />
</Layout>

<style>
  .service-hero {
    position: relative;
    height: 60vh;
    min-height: 420px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(13, 15, 14, 0.97) 0%,
      rgba(13, 15, 14, 0.65) 50%,
      rgba(13, 15, 14, 0.3) 100%
    );
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem 4rem;
    width: 100%;
  }

  .breadcrumb {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
    transition: color 0.2s;
  }

  .breadcrumb:hover {
    color: var(--color-accent);
  }

  .service-tag {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .service-tag::before {
    content: "";
    display: block;
    width: 24px;
    height: 1px;
    background: var(--color-accent);
  }

  .hero-content h1 {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 5rem);
    line-height: 0.95;
    letter-spacing: 0.03em;
    color: var(--color-text);
    margin-bottom: 1rem;
  }

  .service-lead {
    font-size: 1rem;
    color: rgba(232, 228, 220, 0.7);
    max-width: 560px;
    line-height: 1.75;
    margin-bottom: 2rem;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 2rem;
    background: var(--color-accent);
    color: #000;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-radius: 2px;
    border: none;
    cursor: pointer;
    transition: background 0.2s, transform 0.15s;
  }

  .btn-primary:hover {
    background: #26a226;
    transform: translateY(-1px);
  }

  .service-body-wrap {
    padding: 5rem 2rem 7rem;
  }

  .service-content {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 4rem;
    align-items: start;
  }

  .prose {
    margin-bottom: 3rem;
  }

  .prose p {
    font-size: 1rem;
    color: var(--color-text-muted);
    line-height: 1.85;
    margin-bottom: 1.5rem;
  }

  .deliverables h2 {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    letter-spacing: 0.05em;
    color: var(--color-text);
    margin-bottom: 1.75rem;
  }

  .deliverables ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .deliverables li {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    font-size: 0.95rem;
    color: var(--color-text);
    line-height: 1.6;
    padding: 1rem 1.25rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: 2px solid var(--color-accent);
  }

  .bullet {
    color: var(--color-accent);
    font-size: 0.65rem;
    flex-shrink: 0;
    margin-top: 0.35rem;
  }

  .service-sidebar {
    position: sticky;
    top: 6rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .cta-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border-strong);
    border-top: 3px solid var(--color-accent);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .cta-tag {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .cta-card h3 {
    font-family: var(--font-display);
    font-size: 1.5rem;
    letter-spacing: 0.06em;
    color: var(--color-text);
  }

  .cta-card > p {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: 0.25rem;
  }

  .contact-direct {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    color: var(--color-text-muted);
    transition: color 0.2s;
    margin-top: 0.25rem;
  }

  .contact-direct:hover {
    color: var(--color-text);
  }

  .other-services {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    overflow: hidden;
  }

  .sidebar-heading {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface-2);
  }

  .other-service-link {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.9rem 1.25rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    border-bottom: 1px solid var(--color-border);
    transition: color 0.2s, background 0.2s;
  }

  .other-service-link:last-child {
    border-bottom: none;
  }

  .other-service-link:hover {
    color: var(--color-text);
    background: var(--color-surface-2);
  }

  .other-service-icon {
    width: 1.1rem;
    height: 1.1rem;
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .arrow {
    margin-left: auto;
    color: var(--color-text-dim);
    flex-shrink: 0;
  }

  @media (max-width: 1024px) {
    .service-content {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .service-sidebar {
      position: static;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }
  }

  @media (max-width: 640px) {
    .service-sidebar {
      grid-template-columns: 1fr;
    }
  }
</style>
