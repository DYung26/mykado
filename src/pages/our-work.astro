---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
import { workPhotos } from '../data/our-work';
---

<Layout
  title="Our Work | HVAC & Facility Maintenance in Lagos | Mykado Engineering"
  description="Photos of Mykado Engineering technicians servicing rooftop chillers, cooling coils, and refrigerant systems on active sites across Lagos, Nigeria."
>
  <Navbar />

  <section class="work-hero">
    <div class="work-hero-inner">
      <a href="/#our-work" class="breadcrumb">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" width="14" height="14">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
        </svg>
        Home
      </a>
      <p class="work-tag">See Us At Work</p>
      <h1>Our Work</h1>
      <p class="work-lead">
        A record of Mykado technicians on active jobs across Lagos — servicing rooftop
        chillers, inspecting coil banks, and handling refrigerant recovery. Real sites,
        real crew, real work.
      </p>
    </div>
  </section>

  <section class="work-gallery">
    <div class="work-gallery-inner">
      {workPhotos.map((photo) => (
        <figure class="work-gallery-item">
          <button
            type="button"
            class="work-gallery-img-btn"
            data-lightbox-trigger="our-work-gallery"
            data-full-src={photo.image.src}
            data-alt={photo.alt}
            data-caption={photo.caption}
            aria-label={`View full image: ${photo.caption}`}
          >
            <Image src={photo.image} alt={photo.alt} width={800} height={800} loading="lazy" />
          </button>
          <figcaption>{photo.caption}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="work-cta">
    <div class="work-cta-inner">
      <h2>Need Similar Work Done?</h2>
      <p>Talk to our engineers about servicing, maintenance, or installation for your site.</p>
      <a href="/#contact" class="btn-primary">Get In Touch</a>
    </div>
  </section>

  <Lightbox groupId="our-work-gallery" />

  <Footer />
</Layout>

<style>
  .work-hero {
    padding: 9rem 2rem 4rem;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .work-hero-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .breadcrumb {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
    transition: color 0.2s;
  }

  .breadcrumb:hover {
    color: var(--color-accent);
  }

  .work-tag {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .work-tag::before {
    content: "";
    display: block;
    width: 24px;
    height: 1px;
    background: var(--color-accent);
  }

  .work-hero-inner h1 {
    font-family: var(--font-display);
    font-size: clamp(3rem, 7vw, 5.5rem);
    line-height: 0.95;
    letter-spacing: 0.02em;
    color: var(--color-text);
    margin-bottom: 1.25rem;
  }

  .work-lead {
    font-size: 1rem;
    color: var(--color-text-muted);
    max-width: 620px;
    line-height: 1.8;
  }

  .work-gallery {
    padding: 5rem 2rem;
  }

  .work-gallery-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .work-gallery-item {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  .work-gallery-img-btn {
    display: block;
    width: 100%;
    height: 340px;
    background: var(--color-bg);
    border: none;
    padding: 0;
    cursor: pointer;
    overflow: hidden;
  }

  .work-gallery-img-btn img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: grayscale(10%);
    transition: filter 0.3s ease, transform 0.3s ease;
  }

  .work-gallery-img-btn:hover img {
    filter: grayscale(0%);
    transform: scale(1.02);
  }

  .work-gallery-item figcaption {
    padding: 1rem 1.25rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    border-top: 1px solid var(--color-border);
  }

  .work-cta {
    padding: 6rem 2rem 8rem;
    text-align: center;
  }

  .work-cta-inner {
    max-width: 560px;
    margin: 0 auto;
  }

  .work-cta-inner h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    letter-spacing: 0.03em;
    color: var(--color-text);
    margin-bottom: 0.75rem;
  }

  .work-cta-inner p {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.8;
    margin-bottom: 2rem;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 2rem;
    background: var(--color-accent);
    color: #000;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-radius: 2px;
    border: none;
    cursor: pointer;
    transition: background 0.2s, transform 0.15s;
  }

  .btn-primary:hover {
    background: #26a226;
    transform: translateY(-1px);
  }

  @media (max-width: 1024px) {
    .work-gallery-inner {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .work-gallery-inner {
      grid-template-columns: 1fr;
    }

    .work-hero {
      padding-top: 7rem;
    }
  }
</style>
